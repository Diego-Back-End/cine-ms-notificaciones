# Plantilla de variables locales para ms-notificaciones.
# Copia este archivo a .env.local y completa los valores. NO subas .env.local al repositorio.
MAIL_ENABLED=true
MAIL_USER=
MAIL_FROM=
MAIL_PASS=
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_SSL=false
